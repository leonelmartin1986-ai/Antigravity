{
  "name": "word-beat",
  "version": "1.0.0",
  "private": true,
  "description": "Juego para aprender las 200 palabras más usadas del inglés hablado y de las canciones.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 8080 --directory app",
    "build:single": "node tools/build-single.js dist/word-beat.html",
    "wordlist": "node tools/gen-wordlist.js > WORDS.md",
    "phrases": "node tools/gen-phrases.js > PHRASES.md"
  }
}
